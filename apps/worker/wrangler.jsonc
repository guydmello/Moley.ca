{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "moley",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" },
      { "name": "ABUSE_GATE", "class_name": "AbuseGate" }
    ]
  },
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["AbuseGate"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [
    { "pattern": "moley.ca", "custom_domain": true },
    { "pattern": "www.moley.ca", "custom_domain": true }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "FEATURE_FLAGS_JSON": "{\"ai\":\"production\",\"chat\":\"production\",\"customPacks\":\"beta\",\"drawing\":\"beta\",\"spectatorPredictions\":\"beta\",\"externalSharing\":\"production\",\"cosmetics\":\"beta\",\"chaos\":\"beta\",\"audience\":\"beta\",\"careerStats\":\"production\",\"french\":\"beta\"}"
  }
}
